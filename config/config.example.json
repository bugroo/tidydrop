      },
      {
        "extensions" : [
          "torrent"
        ],
        "mime_prefixes" : [

        ],
        "mime_types" : [
          "application/x-bittorrent"
        ],
        "name" : "Torrents",
        "name_patterns" : [

        ]
      },
      {
        "extensions" : [

        ],
        "mime_prefixes" : [

        ],
        "mime_types" : [

        ],
        "name" : "Otros",
        "name_patterns" : [

        ]
      }
    ],
    "fallback_category" : "Otros",
    "use_mime_fallback" : true
  },
  "collision" : {
    "max_attempts" : 10000,
    "strategy" : "numbered_suffix"
  },
  "exclusions" : {
    "extensions" : [
      "crdownload",
      "download",
      "part",
      "partial",
      "tmp",
      "temp",
      "opdownload",
      "filepart",
      "aria2",
      "icloud"
    ],
    "filenames" : [
      ".DS_Store",
      ".localized",
      "Icon\r"
    ],
    "ignore_hidden" : true,
    "ignore_symlinks" : true,
    "name_patterns" : [
      "(?i)^~\\$.*",
      "(?i)^\\.com\\.google\\.Chrome\\..*",
      "(?i).*\\.(crdownload|download|part|partial|tmp|temp|opdownload|filepart|aria2|icloud)$"
    ]
  },
  "logging" : {
    "log_skipped_files" : false,
    "max_file_bytes" : 5242880,
    "rotated_file_count" : 3,
    "suppress_scheduled_noop_audit" : true,
    "transaction_manifest_limit" : 100
  },
  "paths" : {
    "destination_root" : "~/Downloads",
    "log_directory" : "~/Library/Logs/TidyDrop",
    "source_directory" : "~/Downloads",
    "state_directory" : "~/Library/Application Support/TidyDrop/state"
  },
  "safety" : {
    "max_files_per_run" : 5000,
    "require_destination_inside_source" : true
  },
  "stability" : {
    "minimum_age_seconds" : 45,
    "minimum_stable_observations" : 2,
    "probe_delay_milliseconds" : 750,
    "state_retention_seconds" : 86400
  },
  "version" : 1
}
