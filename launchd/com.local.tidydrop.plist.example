<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.tidydrop</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/TidyDrop.app/Contents/MacOS/tidydrop</string>
    <string>run</string>
    <string>--scheduled</string>
    <string>--config</string>
    <string>__HOME__/Library/Application Support/TidyDrop/config.json</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Nice</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.local.tidydrop</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
